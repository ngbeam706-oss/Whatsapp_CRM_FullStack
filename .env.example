# Copy to .env for local dev, and add the same keys in Netlify:
# Site configuration -> Environment variables. Never commit or zip the real .env.

PORT=3000

# --- Meta WhatsApp Cloud API (server only) ---
WHATSAPP_TOKEN=
PHONE_NUMBER=
PHONE_NUMBER_ID=
VERIFY_TOKEN=
# Meta App Dashboard -> App settings -> Basic -> App secret. Used to verify webhook signatures.
APP_SECRET=
GRAPH_API_VERSION=v26.0
# Only for local testing with hand-written webhook payloads. Never set in production.
# ALLOW_UNSIGNED_WEBHOOKS=true

# --- Supabase ---
# Public values (safe in the browser):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Secret key (server only, bypasses RLS). Supabase -> Project Settings -> API Keys -> secret / service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this site, used in customer call links.
PUBLIC_SITE_URL=https://monumental-semolina-e9f403.netlify.app

# Optional: extra origins allowed to call /api (comma-separated). Leave empty for same-origin only.
# ALLOWED_ORIGINS=

# WhatsApp Business Account ID (Meta app -> WhatsApp -> API Setup). Needed for templates and broadcasts.
WABA_ID=

# AI assistant: provider, model and API key are set by the owner on the dashboard's AI page
# (stored encrypted with APP_SECRET). Optional: a separate encryption secret, 32+ characters.
# SETTINGS_ENCRYPTION_KEY=
# Local testing only: allow an http:// or office-network AI base URL (e.g. http://192.168.1.29:8000/v1).
# Never set this on Netlify.
# ALLOW_PRIVATE_AI_URL=true

# End-to-end smoke tests (npm run e2e, see e2e/README.md). Local only, never on Netlify.
# A TEST staff login (owner or manager), never a real person's password:
# E2E_EMAIL=
# E2E_PASSWORD=
# Optional, sends a real WhatsApp message: a test number that messaged the business in the last 24h.
# E2E_SEND_TO=
